APP_NAME=ai-ugc-creator
APP_ENV=development
LOG_LEVEL=INFO
STORAGE_ROOT=./data/storage
PUBLIC_BASE_URL=http://localhost:8000
MAX_UPLOAD_SIZE_MB=500
DOWNLOAD_TIMEOUT_SECONDS=120
ALLOWED_EXTENSIONS=.mp4,.mov
ALLOWED_MIME_TYPES=video/mp4,video/quicktime
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Cheap video model for select-frame + motionPrompt (hook analyzer)
HOOK_ANALYZER_MOTION_MODEL=gemini-3.1-flash-lite
# Pipeline Hook Text: one video call (OCR+ASR+variants)
HOOK_TEXT_MODEL=gemini-3.1-flash-lite
HOOK_TEXT_FALLBACK_MODEL=gemini-2.5-flash
# Standalone /adapt text-only (no video)
GEMINI_TEXT_MODEL=gemini-2.5-flash-lite
FACE_REPLACEMENT_PROVIDER=gemini
FACE_REPLACEMENT_MODEL=gemini-3-pro-image
FACE_REPLACEMENT_TIMEOUT_SECONDS=300
MAX_FACE_IMAGE_SIZE_MB=20
MIN_SELECTED_FRAME_WIDTH=512
MIN_SELECTED_FRAME_HEIGHT=512
MIN_FACE_REFERENCE_WIDTH=256
MIN_FACE_REFERENCE_HEIGHT=256
HOOK_VIDEO_PROVIDER=kling
HOOK_VIDEO_MODEL=kling-3.0
HOOK_VIDEO_TIMEOUT_SECONDS=300
HOOK_VIDEO_MIN_DURATION_SECONDS=2
HOOK_VIDEO_MAX_DURATION_SECONDS=4
HOOK_VIDEO_DURATION_TOLERANCE_SECONDS=0.25
HOOK_VIDEO_HTTP_SUBMIT_URL=
HOOK_VIDEO_HTTP_STATUS_URL=
HOOK_VIDEO_HTTP_API_KEY=
MAX_HOOK_FRAME_SIZE_MB=20
MAX_TEXT_RENDER_VIDEO_SIZE_MB=200
MAX_PRODUCT_DEMO_VIDEO_SIZE_MB=500
MAX_MUSIC_OVERLAY_VIDEO_SIZE_MB=500
MAX_MUSIC_OVERLAY_AUDIO_SIZE_MB=100
KLING_API_KEY=
KLING_API_BASE_URL=https://api-singapore.klingai.com
KLING_AUDIO=off
KLING_MULTI_SHOT=false
KLING_PREFER_BASE64=false
